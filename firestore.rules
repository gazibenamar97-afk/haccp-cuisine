rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function activeUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && profile().active == true;
    }

    function isAdmin() {
      return activeUser()
        && profile().site == "main"
        && profile().role == "admin";
    }

    function isSiteManager() {
      return activeUser()
        && profile().role == "responsable"
        && profile().site != "main";
    }


    /* ================================
       DONNÉES HACCP DES ÉTABLISSEMENTS
       ================================ */

    match /appState/{siteId} {

      allow read: if activeUser()
        && (
          isAdmin()
          || profile().site == siteId
        );

      allow create: if activeUser()
        && (
          isAdmin()
          || (
            profile().site == siteId
            && !request.resource.data.keys().hasAny([
              'maxUsers', 'subscriptionPlan',
              'subscriptionStatus', 'subscriptionExpiresAt'
            ])
          )
        );

      // NOUVEAU : seuls l'administrateur et les responsables
      // peuvent modifier les paramètres (code PIN administrateur).
      allow update: if activeUser()
        && (
          isAdmin()
          || profile().site == siteId
        )
        && (
          isAdmin()
          || isSiteManager()
          || !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['settings'])
        )
        // Les limites commerciales et les statuts d'abonnement
        // sont exclusivement pilotés par le compte administrateur.
        && (
          isAdmin()
          || !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny([
                 'maxUsers', 'subscriptionPlan',
                 'subscriptionStatus', 'subscriptionExpiresAt'
               ])
        );

      allow delete: if false;
    }


    /* ================================
       UTILISATEURS
       ================================ */

    match /users/{userId} {

      // Chaque utilisateur peut lire son propre profil.
      // L'administrateur peut lire tous les profils.
      // Un responsable peut lire tous les profils
      // appartenant à son établissement.
      allow read: if activeUser()
        && (
          request.auth.uid == userId
          || isAdmin()
          || (
            isSiteManager()
            && resource.data.site == profile().site
          )
        );


      // Création des utilisateurs
      allow create: if isAdmin()
        || (
          isSiteManager()

          && request.resource.data.site == profile().site

          // NOUVEAU : l'identifiant du profil doit correspondre au compte
          && request.resource.data.uid == userId

          && (
            request.resource.data.role == "responsable"
            || request.resource.data.role == "haccp"
            || request.resource.data.role == "employe"
          )

          && request.resource.data.active == true
        );


      // Modification
      allow update: if isAdmin()
        || (
          isSiteManager()

          && resource.data.site == profile().site
          && request.resource.data.site == resource.data.site

          && (
            resource.data.role == "responsable"
            || resource.data.role == "haccp"
            || resource.data.role == "employe"
          )

          && (
            request.resource.data.role == "responsable"
            || request.resource.data.role == "haccp"
            || request.resource.data.role == "employe"
          )

          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
        );

      // Pas de suppression définitive
      allow delete: if false;
    }


    /* ================================
       LISTE DES UTILISATEURS PAR SITE
       ================================ */

    match /appUsers/{siteId} {

      allow read: if activeUser()
        && (
          isAdmin()
          || (
            isSiteManager()
            && profile().site == siteId
          )
        );

      allow create, update: if activeUser()
        && (
          isAdmin()
          || (
            isSiteManager()
            && profile().site == siteId
          )
        );

      allow delete: if false;
    }


    /* ================================
       TOUT LE RESTE EST BLOQUÉ
       ================================ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}